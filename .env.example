# Chat delivery. Fixture runs use mock and never call a network endpoint.
DELIVERY_ADAPTER=mock
DELIVERY_WEBHOOK_URL=

# Optional model enrichment. Set adapters.analyzer: hybrid-openai for an
# OpenAI-compatible /chat/completions endpoint. Rules keep numeric prices when
# the model is unavailable, throttled, or returns invalid evidence.
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=

# Feishu Base projection. Required only for adapters.projection: feishu-base.
# Do not place these values in YAML or commit a populated .env file.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OWNER_EMAIL=
FEISHU_VIEWER_CHAT_ID=
