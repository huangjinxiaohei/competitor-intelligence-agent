{
  "$defs": {
    "ChangeEvent": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "field_path": {
          "title": "Field Path",
          "type": "string"
        },
        "before": {
          "default": null,
          "title": "Before"
        },
        "after": {
          "default": null,
          "title": "After"
        },
        "importance": {
          "$ref": "#/$defs/ChangeImportance"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "confirmed": {
          "default": true,
          "title": "Confirmed",
          "type": "boolean"
        },
        "detected_at": {
          "format": "date-time",
          "title": "Detected At",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "field_path",
        "importance"
      ],
      "title": "ChangeEvent",
      "type": "object"
    },
    "ChangeImportance": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "ChangeImportance",
      "type": "string"
    },
    "DigestProduct": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "homepage": {
          "title": "Homepage",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "features": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Features",
          "type": "array"
        },
        "pricing": {
          "items": {
            "$ref": "#/$defs/PriceTier"
          },
          "maxItems": 3,
          "title": "Pricing",
          "type": "array"
        },
        "configurations": {
          "additionalProperties": true,
          "maxProperties": 3,
          "title": "Configurations",
          "type": "object"
        },
        "confidence": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_urls": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "title": "Evidence Urls",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "name",
        "homepage"
      ],
      "title": "DigestProduct",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "excerpt",
        "observed_at"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "PriceTier": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "qualifiers": {
          "items": {
            "type": "string"
          },
          "title": "Qualifiers",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "PriceTier",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/ChangeEvent"
      },
      "title": "Changes",
      "type": "array"
    },
    "products": {
      "items": {
        "$ref": "#/$defs/DigestProduct"
      },
      "maxItems": 5,
      "title": "Products",
      "type": "array"
    },
    "failed_sources": {
      "items": {
        "type": "string"
      },
      "title": "Failed Sources",
      "type": "array"
    },
    "report_path": {
      "title": "Report Path",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "kind",
    "title",
    "summary",
    "report_path"
  ],
  "title": "Digest",
  "type": "object"
}
