{
  "$defs": {
    "ChangeEvent": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "field_path": {
          "title": "Field Path",
          "type": "string"
        },
        "before": {
          "default": null,
          "title": "Before"
        },
        "after": {
          "default": null,
          "title": "After"
        },
        "importance": {
          "$ref": "#/$defs/ChangeImportance"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "confirmed": {
          "default": true,
          "title": "Confirmed",
          "type": "boolean"
        },
        "detected_at": {
          "format": "date-time",
          "title": "Detected At",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "field_path",
        "importance"
      ],
      "title": "ChangeEvent",
      "type": "object"
    },
    "ChangeImportance": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "ChangeImportance",
      "type": "string"
    },
    "DeliveryReceipt": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "title": "Adapter",
          "type": "string"
        },
        "delivered": {
          "title": "Delivered",
          "type": "boolean"
        },
        "status_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Code"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "delivered"
      ],
      "title": "DeliveryReceipt",
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/ChangeEvent"
          },
          "title": "Changes",
          "type": "array"
        },
        "failed_sources": {
          "items": {
            "type": "string"
          },
          "title": "Failed Sources",
          "type": "array"
        },
        "report_path": {
          "title": "Report Path",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "kind",
        "title",
        "summary",
        "report_path"
      ],
      "title": "Digest",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "excerpt",
        "observed_at"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "success",
        "partial",
        "failed"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "candidate_count": {
      "default": 0,
      "title": "Candidate Count",
      "type": "integer"
    },
    "snapshot_count": {
      "default": 0,
      "title": "Snapshot Count",
      "type": "integer"
    },
    "change_count": {
      "default": 0,
      "title": "Change Count",
      "type": "integer"
    },
    "digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "delivery": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeliveryReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "status",
    "started_at",
    "finished_at"
  ],
  "title": "RunResult",
  "type": "object"
}
